# syntax=docker/dockerfile:1
# NPL scheduled job. Build: docker build -f Dockerfile.pipeline -t pipeline .
# ECS injects LAKE_BUCKET and the FiinQuant credentials at runtime.
FROM python:3.12-slim AS pipeline
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1 PYTHONPATH=/job/engine
WORKDIR /job
COPY requirements.txt .
COPY tools/fiinquant/fiinquantx-0.1.73-py3-none-any.whl /tmp/
RUN pip install -r requirements.txt awscli /tmp/fiinquantx-0.1.73-py3-none-any.whl
COPY engine engine
COPY scenarios scenarios
COPY tools tools
# The CLIs resolve these dotenv references from the environment at runtime.
COPY <<'EOF' /usr/local/share/fiinquant.env
FIINQUANT_USERNAME=${FIINQUANT_USERNAME}
FIINQUANT_PASSWORD=${FIINQUANT_PASSWORD}
EOF

COPY <<'EOF' /usr/local/bin/pipeline-entrypoint
#!/bin/sh
set -e
credentials=/usr/local/share/fiinquant.env

if [ "$PIPELINE_MODE" = "ratewatch" ]; then
  if [ -n "$FIINQUANT_USERNAME" ] && [ -n "$FIINQUANT_PASSWORD" ]; then
    set -- --credentials "$credentials" "$@"
  fi
  exec python -m vlkit.ratewatch.pipeline "$@"
fi

: "${LAKE_BUCKET:?LAKE_BUCKET is required}"
lake_uri="s3://$LAKE_BUCKET/lake/npl/"
snapshot=web/seed/npl/snapshot.json

aws s3 sync "$lake_uri" data/lake/npl/
python -m vlkit.npl.ingest --all --credentials "$credentials"
python -m vlkit.npl.pipeline --real data/lake/npl/silver --out out/npl
python -m vlkit.npl.snapshot \
  --results out/npl/results.json \
  --gold out/npl/gold.duckdb \
  --silver data/lake/npl/silver \
  --out "$snapshot"

python - "$snapshot" <<'PY'
import csv
import json
import sys
from pathlib import Path

snapshot = json.loads(Path(sys.argv[1]).read_bytes())
failures = [gate["id"] for gate in snapshot["meta"]["quality"] if gate["status"] == "fail"]
notes_gates = Path("data/lake/npl/silver/notes_gate.csv")
if notes_gates.is_file():
    with notes_gates.open(encoding="utf-8-sig", newline="") as rows:
        failures.extend(
            f'{gate["gate"]} ({gate["bank"]} {gate["period"]})'
            for gate in csv.DictReader(rows) if gate["status"] == "fail"
        )
if failures:
    raise SystemExit("NPL quality gates failed: " + ", ".join(failures))
PY

aws s3 sync data/lake/npl/ "$lake_uri"
aws s3 sync out/npl/ "s3://$LAKE_BUCKET/out/npl/"
aws s3 cp "$snapshot" "s3://$LAKE_BUCKET/snapshots/npl/snapshot.json"
EOF
RUN chmod 755 /usr/local/bin/pipeline-entrypoint \
  && useradd --create-home --uid 10001 pipeline \
  && mkdir -p data/lake out web/seed/npl && chown -R pipeline:pipeline /job
USER pipeline
ENTRYPOINT ["pipeline-entrypoint"]
# CMD args only apply to PIPELINE_MODE=ratewatch (--stage all); the default NPL chain is fixed.
CMD ["--stage", "all"]
