{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "story.schema.json",
 "title": "POST /api/story response (web/src/lib/analyst/story.ts Story; question/limits added by feature 002, optional for older clients)",
 "type": "object",
 "properties": {
  "mode": {
   "enum": [
    "llm",
    "offline"
   ]
  },
  "model": {
   "type": [
    "string",
    "null"
   ]
  },
  "headline": {
   "type": "string"
  },
  "steps": {
   "type": "array",
   "items": {
    "type": "object",
    "properties": {
     "id": {
      "type": "string"
     },
     "rank": {
      "type": "integer"
     },
     "title": {
      "type": "string"
     },
     "narration": {
      "type": "string"
     },
     "stats": {
      "type": "string"
     },
     "action": {
      "type": [
       "string",
       "null"
      ]
     },
     "source": {
      "enum": [
       "llm",
       "engine"
      ]
     }
    },
    "required": [
     "id",
     "rank",
     "title",
     "narration",
     "stats",
     "source"
    ]
   }
  },
  "closing": {
   "type": "string"
  },
  "question": {
   "type": [
    "object",
    "null"
   ],
   "description": "Decision question quoted from out/<ds>/brief.json; never rewritten by the LLM",
   "properties": {
    "text": {
     "type": "string",
     "maxLength": 2000
    },
    "who": {
     "type": [
      "string",
      "null"
     ],
     "maxLength": 300
    },
    "what": {
     "type": [
      "string",
      "null"
     ],
     "maxLength": 600
    },
    "kpi": {
     "type": [
      "string",
      "null"
     ],
     "maxLength": 300
    },
    "source": {
     "const": "brief"
    }
   },
   "required": [
    "text",
    "source"
   ],
   "additionalProperties": false
  },
  "limits": {
   "type": "array",
   "maxItems": 3,
   "items": {
    "type": "string"
   },
   "description": "Copied verbatim from results.json caveats"
  }
 },
 "required": [
  "mode",
  "model",
  "headline",
  "steps",
  "closing"
 ]
}
