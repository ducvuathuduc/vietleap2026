{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "pipeline.schema.json",
 "title": "out/<ds>/pipeline.json — DE run summary (engine/vlkit/de/flow.py run_flow)",
 "type": "object",
 "properties": {
  "dataset": {
   "type": "string",
   "pattern": "^[a-z0-9_]+$"
  },
  "run_id": {
   "type": "string"
  },
  "finished_at": {
   "type": "string"
  },
  "timings": {
   "type": "object",
   "additionalProperties": {
    "type": "number"
   }
  },
  "steps": {
   "type": "array",
   "items": {
    "type": "object",
    "properties": {
     "step": {
      "type": "string"
     },
     "status": {
      "enum": [
       "ok",
       "failed"
      ]
     },
     "error": {
      "type": "string"
     },
     "tables": {
      "type": "array",
      "items": {
       "type": "string"
      }
     },
     "inserted": {
      "type": "integer"
     },
     "skipped": {
      "type": "integer"
     }
    },
    "required": [
     "step",
     "status"
    ]
   }
  },
  "bronze": {
   "type": "array",
   "items": {
    "type": "string"
   }
  },
  "silver": {
   "type": "array",
   "items": {
    "type": "string"
   }
  },
  "primary": {
   "type": "string"
  },
  "gold": {
   "type": "array",
   "items": {
    "type": "string"
   }
  },
  "quality": {
   "type": "object",
   "additionalProperties": {
    "type": "object",
    "properties": {
     "score_before": {
      "type": "number"
     },
     "score_after": {
      "type": "number"
     },
     "rows": {
      "type": "integer"
     },
     "issues": {
      "type": "integer"
     }
    },
    "required": [
     "score_before",
     "score_after",
     "rows",
     "issues"
    ]
   }
  },
  "models": {
   "type": "object",
   "properties": {
    "obt": {
     "type": "object",
     "properties": {
      "tables": {
       "type": "array",
       "items": {
        "type": "string"
       }
      },
      "erd": {
       "type": "string"
      }
     },
     "required": [
      "tables"
     ]
    },
    "star": {
     "type": "object",
     "properties": {
      "tables": {
       "type": "array",
       "items": {
        "type": "string"
       }
      },
      "erd": {
       "type": "string"
      }
     },
     "required": [
      "tables"
     ]
    },
    "snowflake": {
     "type": "object",
     "properties": {
      "tables": {
       "type": "array",
       "items": {
        "type": "string"
       }
      },
      "erd": {
       "type": "string"
      }
     },
     "required": [
      "tables"
     ]
    },
    "data_vault": {
     "type": "object",
     "properties": {
      "tables": {
       "type": "array",
       "items": {
        "type": "string"
       }
      },
      "erd": {
       "type": "string"
      }
     },
     "required": [
      "tables"
     ]
    },
    "conformed": {
     "type": "object",
     "properties": {
      "tables": {
       "type": "array",
       "items": {
        "type": "string"
       }
      },
      "erd": {
       "type": "string"
      }
     },
     "required": [
      "tables"
     ]
    }
   },
   "additionalProperties": {
    "type": "object",
    "properties": {
     "tables": {
      "type": "array",
      "items": {
       "type": "string"
      }
     },
     "erd": {
      "type": "string"
     }
    },
    "required": [
     "tables"
    ]
   }
  },
  "column_plan": {
   "type": "object"
  },
  "rationale": {},
  "recommended": {},
  "provenance": {
   "type": "array",
   "items": {
    "type": "object",
    "properties": {
     "source": {
      "type": "string"
     },
     "kind": {
      "type": "string"
     },
     "uri": {
      "type": "string"
     },
     "fetched_at": {
      "type": "string"
     },
     "license_note": {
      "type": "string"
     },
     "options": {
      "type": "object"
     },
     "tables": {
      "type": "object"
     }
    },
    "required": [
     "source",
     "kind",
     "uri",
     "fetched_at"
    ]
   }
  },
  "conformed": {
   "oneOf": [
    {
     "type": "null"
    },
    {
     "$ref": "conformed.schema.json"
    }
   ]
  },
  "load": {
   "type": "object",
   "properties": {
    "mode": {
     "enum": [
      "replace",
      "append",
      "incremental"
     ]
    },
    "inserted": {
     "type": "integer"
    },
    "skipped": {
     "type": "integer"
    },
    "tables": {
     "type": "object",
     "additionalProperties": {
      "type": "object",
      "properties": {
       "inserted": {
        "type": "integer",
        "minimum": 0
       },
       "skipped": {
        "type": "integer",
        "minimum": 0
       },
       "rebuilt": {
        "type": "boolean"
       },
       "rows": {
        "type": "integer"
       },
       "reason": {
        "type": [
         "string",
         "null"
        ]
       }
      },
      "required": [
       "inserted",
       "skipped",
       "rebuilt"
      ]
     }
    },
    "silver": {
     "type": "object"
    }
   },
   "required": [
    "mode",
    "inserted",
    "skipped",
    "tables"
   ]
  },
  "served": {
   "type": "boolean"
  }
 },
 "required": [
  "dataset",
  "run_id",
  "finished_at",
  "timings",
  "steps",
  "bronze",
  "silver",
  "primary",
  "gold",
  "quality",
  "models",
  "provenance"
 ]
}
