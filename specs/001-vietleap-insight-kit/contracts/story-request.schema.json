{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "story-request.schema.json",
 "title": "POST /api/story request",
 "type": "object",
 "properties": {
  "datasetId": {
   "type": "string",
   "pattern": "^[\\w.-]{1,80}$"
  },
  "n": {
   "type": "integer",
   "minimum": 1,
   "maximum": 8
  }
 },
 "required": [
  "datasetId"
 ],
 "additionalProperties": false
}
