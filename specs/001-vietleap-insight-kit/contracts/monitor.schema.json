{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "monitor.schema.json",
  "title": "Vietnam Macro-Financial Monitor serving payload (out/vn_monitor/monitor.json)",
  "type": "object",
  "required": ["schema_version", "meta", "sources", "indicators", "series", "sectors", "province", "asean", "recommendations", "quality", "reconciliation"],
  "additionalProperties": false,
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z0-9_]+$"},
    "period": {"type": "string", "pattern": "^\\d{4}(-(0[1-9]|1[0-2])|-Q[1-4]|-\\d{2}-\\d{2})?$"},
    "num": {"type": ["number", "null"]},
    "text": {"type": "string", "minLength": 1},
    "point": {
      "type": "object",
      "required": ["period", "value"],
      "additionalProperties": false,
      "properties": {"period": {"$ref": "#/$defs/period"}, "value": {"$ref": "#/$defs/num"}, "geo": {"type": "string"}}
    },
    "card": {
      "type": "object",
      "required": ["value", "unit", "period", "sentence_vi", "action_vi", "source_id", "rule_id"],
      "additionalProperties": false,
      "properties": {
        "value": {"type": "number"},
        "unit": {"type": "string"},
        "period": {"$ref": "#/$defs/period"},
        "sentence_vi": {"$ref": "#/$defs/text"},
        "action_vi": {"$ref": "#/$defs/text"},
        "source_id": {"$ref": "#/$defs/id"},
        "rule_id": {"type": "string"},
        "indicator_id": {"$ref": "#/$defs/id"},
        "direction": {"enum": ["up", "down", "flat"]},
        "severity": {"enum": ["info", "watch", "alert"]}
      }
    },
    "chart": {
      "type": "object",
      "required": ["id", "kind", "title_vi", "indicator_ids", "source_ids"],
      "additionalProperties": false,
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "number": {"type": "integer", "minimum": 1},
        "kind": {"enum": ["line", "bar", "stacked_bar", "map", "range", "heatmap", "scatter", "table"]},
        "title_vi": {"$ref": "#/$defs/text"},
        "note_vi": {"type": "string"},
        "indicator_ids": {"type": "array", "items": {"$ref": "#/$defs/id"}},
        "source_ids": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/id"}},
        "highlight": {"type": "string"},
        "level": {"enum": ["overview", "drilldown", "detail"]}
      }
    },
    "table": {
      "type": "object",
      "required": ["id", "title_vi", "columns", "rows", "source_ids"],
      "additionalProperties": false,
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "title_vi": {"$ref": "#/$defs/text"},
        "columns": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["key", "label_vi"],
            "additionalProperties": false,
            "properties": {"key": {"$ref": "#/$defs/id"}, "label_vi": {"$ref": "#/$defs/text"}, "unit": {"type": "string"}, "kind": {"enum": ["text", "number", "percent", "date"]}}
          }
        },
        "rows": {"type": "array", "items": {"type": "object"}},
        "source_ids": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/id"}}
      }
    },
    "sector": {
      "type": "object",
      "required": ["question_vi", "headline_vi", "cards", "watch", "charts", "tables"],
      "additionalProperties": false,
      "properties": {
        "question_vi": {"$ref": "#/$defs/text"},
        "headline_vi": {"$ref": "#/$defs/text"},
        "cards": {"type": "array", "maxItems": 3, "items": {"$ref": "#/$defs/card"}},
        "watch": {"type": "array", "maxItems": 4, "items": {"$ref": "#/$defs/text"}},
        "kpi_ids": {"type": "array", "maxItems": 6, "items": {"$ref": "#/$defs/id"}},
        "heatmap": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["indicator_id", "cells"],
            "additionalProperties": false,
            "properties": {
              "indicator_id": {"$ref": "#/$defs/id"},
              "cells": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["period", "value", "pctile"],
                  "additionalProperties": false,
                  "properties": {"period": {"$ref": "#/$defs/period"}, "value": {"$ref": "#/$defs/num"}, "pctile": {"type": ["number", "null"], "minimum": 0, "maximum": 100}}
                }
              }
            }
          }
        },
        "charts": {"type": "array", "items": {"$ref": "#/$defs/chart"}},
        "tables": {"type": "array", "items": {"$ref": "#/$defs/table"}}
      }
    }
  },
  "properties": {
    "schema_version": {"const": 1},
    "meta": {
      "type": "object",
      "required": ["generated_at", "title_vi", "question_vi", "lead_vi"],
      "additionalProperties": false,
      "properties": {
        "generated_at": {"type": "string", "format": "date-time"},
        "title_vi": {"$ref": "#/$defs/text"},
        "question_vi": {"$ref": "#/$defs/text"},
        "lead_vi": {"type": "array", "minItems": 1, "maxItems": 3, "items": {"$ref": "#/$defs/text"}},
        "watch_vi": {"type": "array", "maxItems": 4, "items": {"$ref": "#/$defs/text"}},
        "kpi_ids": {"type": "array", "maxItems": 6, "items": {"$ref": "#/$defs/id"}},
        "headline_card_refs": {"type": "array", "maxItems": 3, "items": {"type": "string"}}
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "publisher", "title_vi", "url", "method", "license", "fetched_at", "data_cutoff"],
        "additionalProperties": false,
        "properties": {
          "id": {"$ref": "#/$defs/id"},
          "publisher": {"$ref": "#/$defs/text"},
          "title_vi": {"$ref": "#/$defs/text"},
          "url": {"type": "string", "format": "uri"},
          "method": {"enum": ["db", "api", "file", "scrape", "social", "tinyfish", "pdf"]},
          "license": {"type": "string"},
          "robots": {"type": "string"},
          "fetched_at": {"type": "string", "format": "date-time"},
          "data_cutoff": {"$ref": "#/$defs/period"},
          "rows": {"type": "integer", "minimum": 0},
          "next_release": {"type": ["string", "null"]}
        }
      }
    },
    "indicators": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name_vi", "sector", "unit", "frequency", "measure_type", "definition_vi", "source_id", "last_updated", "latest", "sparkline"],
        "additionalProperties": false,
        "properties": {
          "id": {"$ref": "#/$defs/id"},
          "name_vi": {"$ref": "#/$defs/text"},
          "name_en": {"type": "string"},
          "sector": {"enum": ["public_finance", "fdi", "banking", "capital_market", "real_estate", "macro", "asean", "province"]},
          "unit": {"type": "string"},
          "frequency": {"enum": ["daily", "weekly", "monthly", "quarterly", "annual", "snapshot"]},
          "measure_type": {"enum": ["level", "ytd", "yoy", "mom", "share", "ratio", "pct_plan", "index"]},
          "definition_vi": {"$ref": "#/$defs/text"},
          "note_vi": {"type": "string"},
          "source_id": {"$ref": "#/$defs/id"},
          "last_updated": {"type": "string"},
          "next_release": {"type": ["string", "null"]},
          "latest": {"$ref": "#/$defs/point"},
          "change": {"type": ["object", "null"], "additionalProperties": false, "properties": {"vs_period": {"$ref": "#/$defs/period"}, "value": {"type": "number"}, "unit": {"type": "string"}}},
          "sparkline": {"type": "array", "maxItems": 36, "items": {"$ref": "#/$defs/point"}},
          "pctile_12m": {"type": ["number", "null"], "minimum": 0, "maximum": 100}
        }
      }
    },
    "series": {"type": "object", "additionalProperties": {"type": "array", "items": {"$ref": "#/$defs/point"}}},
    "sectors": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "public_finance": {"$ref": "#/$defs/sector"},
        "fdi": {"$ref": "#/$defs/sector"},
        "banking": {"$ref": "#/$defs/sector"},
        "capital_market": {"$ref": "#/$defs/sector"},
        "real_estate": {"$ref": "#/$defs/sector"}
      }
    },
    "province": {
      "type": "object",
      "required": ["metric_ids", "rows", "groups"],
      "additionalProperties": false,
      "properties": {
        "question_vi": {"type": "string"},
        "headline_vi": {"type": "string"},
        "metric_ids": {"type": "array", "items": {"$ref": "#/$defs/id"}},
        "primary_metric": {"$ref": "#/$defs/id"},
        "rows": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["code", "name", "region", "metrics", "group"],
            "additionalProperties": false,
            "properties": {
              "code": {"type": "string"}, "name": {"$ref": "#/$defs/text"}, "region": {"type": "string"},
              "metrics": {"type": "object", "additionalProperties": {"$ref": "#/$defs/num"}},
              "group": {"type": ["integer", "null"], "minimum": 1, "maximum": 5}
            }
          }
        },
        "groups": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["group", "label_vi", "min", "max", "count"],
            "additionalProperties": false,
            "properties": {"group": {"type": "integer"}, "label_vi": {"type": "string"}, "min": {"type": "number"}, "max": {"type": "number"}, "count": {"type": "integer"}}
          }
        },
        "stats": {"type": "object", "additionalProperties": {"type": "object", "additionalProperties": false, "properties": {"median": {"type": "number"}, "min": {"type": "number"}, "max": {"type": "number"}, "n": {"type": "integer"}}}},
        "source_ids": {"type": "array", "items": {"$ref": "#/$defs/id"}}
      }
    },
    "asean": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["year", "rows", "vn_rank", "n", "source_id"],
        "additionalProperties": false,
        "properties": {
          "year": {"type": "integer"},
          "rows": {"type": "array", "items": {"type": "object", "required": ["iso3", "name_vi", "value", "rank"], "additionalProperties": false, "properties": {"iso3": {"type": "string"}, "name_vi": {"type": "string"}, "value": {"type": "number"}, "rank": {"type": "integer"}}}},
          "vn_rank": {"type": ["integer", "null"]},
          "n": {"type": "integer"},
          "median": {"type": "number"},
          "higher_is_better": {"type": "boolean"},
          "source_id": {"$ref": "#/$defs/id"}
        }
      }
    },
    "recommendations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title_vi", "evidence", "so_what_vi", "action_vi", "agency_vi", "horizon_vi"],
        "additionalProperties": false,
        "properties": {
          "id": {"$ref": "#/$defs/id"},
          "title_vi": {"$ref": "#/$defs/text"},
          "sector": {"type": "string"},
          "evidence": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["rule_id", "chart_id", "fact_vi"], "additionalProperties": false, "properties": {"rule_id": {"type": "string"}, "chart_id": {"$ref": "#/$defs/id"}, "fact_vi": {"$ref": "#/$defs/text"}}}},
          "so_what_vi": {"$ref": "#/$defs/text"},
          "action_vi": {"$ref": "#/$defs/text"},
          "agency_vi": {"$ref": "#/$defs/text"},
          "horizon_vi": {"$ref": "#/$defs/text"},
          "caveat_vi": {"type": "string"}
        }
      }
    },
    "rules": {
      "type": "array",
      "items": {"type": "object", "required": ["id", "name_vi", "formula_vi", "threshold_vi", "fired"], "additionalProperties": false, "properties": {"id": {"type": "string"}, "name_vi": {"type": "string"}, "formula_vi": {"type": "string"}, "threshold_vi": {"type": "string"}, "fired": {"type": "boolean"}, "agency_vi": {"type": "string"}}}
    },
    "quality": {
      "type": "array",
      "items": {"type": "object", "required": ["source_id", "rows", "score_before", "score_after", "flags"], "additionalProperties": false, "properties": {"source_id": {"$ref": "#/$defs/id"}, "rows": {"type": "integer"}, "score_before": {"type": "number"}, "score_after": {"type": "number"}, "flags": {"type": "object", "additionalProperties": {"type": "integer"}}}}
    },
    "reconciliation": {
      "type": "array",
      "items": {"type": "object", "required": ["indicator_id", "period", "values", "diff_pct", "verdict"], "additionalProperties": false, "properties": {"indicator_id": {"$ref": "#/$defs/id"}, "period": {"$ref": "#/$defs/period"}, "values": {"type": "object", "additionalProperties": {"type": "number"}}, "diff_pct": {"type": "number"}, "tolerance_pct": {"type": "number"}, "verdict": {"enum": ["match", "mismatch", "single_source"]}, "note_vi": {"type": "string"}}}
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "properties": {"erd_mermaid": {"type": "string"}, "tables": {"type": "array", "items": {"type": "object", "required": ["name", "layer", "rows"], "additionalProperties": false, "properties": {"name": {"type": "string"}, "layer": {"enum": ["bronze", "silver", "gold"]}, "rows": {"type": "integer"}, "grain_vi": {"type": "string"}}}}}
    },
    "files": {"type": "object", "additionalProperties": {"type": "string"}}
  }
}
