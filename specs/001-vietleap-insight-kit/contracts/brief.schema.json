{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "brief.schema.json",
 "title": "brief.json — problem statement parsed by engine/vlkit/brief.py parse_brief (POST /api/brief)",
 "type": "object",
 "properties": {
  "language": {
   "enum": [
    "vi",
    "en"
   ]
  },
  "title": {
   "type": "string"
  },
  "questions": {
   "type": "array",
   "items": {
    "type": "string"
   }
  },
  "target": {
   "oneOf": [
    {
     "type": "null"
    },
    {
     "type": "object",
     "properties": {
      "concept": {
       "type": "string"
      },
      "label": {
       "type": "string"
      },
      "column": {
       "type": [
        "string",
        "null"
       ]
      },
      "resolved": {
       "type": "string"
      },
      "domain": {
       "type": [
        "string",
        "null"
       ]
      },
      "score": {
       "type": "number"
      }
     },
     "required": [
      "concept",
      "label",
      "column",
      "resolved"
     ]
    }
   ]
  },
  "alternatives": {
   "type": "array",
   "items": {
    "type": "object",
    "properties": {
     "concept": {
      "type": "string"
     },
     "label": {
      "type": "string"
     },
     "column": {
      "type": [
       "string",
       "null"
      ]
     },
     "resolved": {
      "type": "string"
     },
     "domain": {
      "type": [
       "string",
       "null"
      ]
     },
     "score": {
      "type": "number"
     }
    },
    "required": [
     "concept",
     "label",
     "column",
     "resolved"
    ]
   }
  },
  "units": {
   "type": "array",
   "items": {
    "type": "string"
   }
  },
  "segments": {
   "type": "array",
   "items": {
    "type": "string"
   }
  },
  "time": {
   "type": "object",
   "properties": {
    "years": {
     "type": "array",
     "items": {
      "type": "integer"
     }
    },
    "range": {
     "oneOf": [
      {
       "type": "null"
      },
      {
       "type": "array",
       "items": {
        "type": "integer"
       },
       "minItems": 2,
       "maxItems": 2
      }
     ]
    }
   },
   "required": [
    "years",
    "range"
   ]
  },
  "decision_types": {
   "type": "array",
   "items": {
    "type": "object",
    "properties": {
     "id": {
      "type": "string"
     },
     "label": {
      "type": "string"
     },
     "hits": {
      "type": "integer"
     }
    },
    "required": [
     "id",
     "label",
     "hits"
    ]
   }
  },
  "deliverables": {
   "type": "array",
   "items": {
    "type": "string"
   }
  },
  "data_sources_mentioned": {
   "type": "array",
   "items": {
    "type": "string"
   }
  },
  "pack": {
   "oneOf": [
    {
     "type": "null"
    },
    {
     "type": "object",
     "properties": {
      "id": {
       "type": "string"
      },
      "title": {
       "type": "string"
      }
     },
     "required": [
      "id",
      "title"
     ]
    }
   ]
  },
  "pack_scores": {
   "type": "object"
  },
  "run_config": {
   "type": "object",
   "properties": {
    "target": {
     "type": [
      "string",
      "null"
     ]
    },
    "domain": {
     "type": "string"
    },
    "segment_by": {
     "type": "array",
     "items": {
      "type": "string"
     }
    }
   },
   "required": [
    "target",
    "domain",
    "segment_by"
   ]
  },
  "plan": {
   "type": "array",
   "items": {
    "type": "string"
   }
  },
  "warnings": {
   "type": "array",
   "items": {
    "type": "string"
   }
  },
  "dataset": {
   "type": [
    "string",
    "null"
   ]
  }
 },
 "required": [
  "language",
  "title",
  "questions",
  "target",
  "units",
  "segments",
  "time",
  "decision_types",
  "pack",
  "run_config",
  "plan",
  "warnings"
 ]
}
