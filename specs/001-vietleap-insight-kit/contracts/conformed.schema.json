{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "conformed.schema.json",
 "title": "out/<ds>/conformed.json (engine/vlkit/de/conformed.py build_conformed diagnostics)",
 "type": "object",
 "properties": {
  "shared_keys": {
   "type": "array",
   "items": {
    "type": "string"
   }
  },
  "dims": {
   "type": "object",
   "additionalProperties": {
    "type": "string"
   }
  },
  "facts": {
   "type": "object",
   "additionalProperties": {
    "type": "string"
   }
  },
  "integrated": {
   "type": "string"
  },
  "integrated_rows": {
   "type": "integer"
  },
  "base": {
   "type": "array",
   "items": {
    "type": "string"
   }
  },
  "base_rows": {
   "type": "integer"
  },
  "row_explosion": {
   "type": "boolean"
  },
  "joins": {
   "type": "array",
   "items": {
    "type": "object",
    "properties": {
     "source": {
      "type": "string"
     },
     "keys": {
      "type": "array",
      "items": {
       "type": "string"
      }
     },
     "status": {
      "type": "string"
     },
     "join_on": {
      "type": "array",
      "items": {
       "type": "string"
      }
     },
     "matched_rows": {
      "type": "integer"
     },
     "unmatched_rows": {
      "type": "integer"
     },
     "match_pct": {
      "type": "number"
     },
     "unmatched_samples": {
      "type": "array",
      "items": {
       "type": "string"
      }
     },
     "columns_added": {
      "type": "integer"
     },
     "aggregated": {
      "type": [
       "string",
       "null"
      ]
     },
     "where": {
      "type": [
       "string",
       "null"
      ]
     }
    },
    "required": [
     "source",
     "keys",
     "status"
    ]
   }
  },
  "sources": {
   "type": "array",
   "items": {
    "type": "object",
    "properties": {
     "table": {
      "type": "string"
     },
     "source": {
      "type": "string"
     },
     "rows": {
      "type": "integer"
     },
     "geo_level": {
      "type": [
       "string",
       "null"
      ]
     },
     "keys": {
      "type": "object",
      "additionalProperties": {
       "type": "object",
       "properties": {
        "column": {
         "type": [
          "string",
          "null"
         ]
        },
        "matched_rows": {
         "type": "integer"
        },
        "null_key_rows": {
         "type": "integer"
        },
        "unmatched_rows": {
         "type": "integer"
        },
        "match_pct": {
         "type": "number"
        },
        "outside_reference_rows": {
         "type": "integer"
        }
       },
       "required": [
        "matched_rows",
        "unmatched_rows",
        "match_pct"
       ]
      }
     }
    },
    "required": [
     "table",
     "source",
     "rows",
     "keys"
    ]
   }
  },
  "overlap": {
   "type": "array",
   "items": {
    "type": "object",
    "properties": {
     "key": {
      "type": "string"
     },
     "a": {
      "type": "string"
     },
     "b": {
      "type": "string"
     },
     "a_keys": {
      "type": "integer"
     },
     "b_keys": {
      "type": "integer"
     },
     "shared_keys": {
      "type": "integer"
     },
     "jaccard": {
      "type": "number"
     }
    },
    "required": [
     "key",
     "a",
     "b",
     "a_keys",
     "b_keys",
     "shared_keys",
     "jaccard"
    ]
   }
  },
  "detected": {
   "type": "object"
  }
 },
 "required": [
  "shared_keys",
  "dims",
  "facts",
  "integrated",
  "integrated_rows",
  "joins",
  "sources",
  "overlap"
 ]
}
