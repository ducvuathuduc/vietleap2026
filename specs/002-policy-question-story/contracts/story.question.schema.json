{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "story.question.schema.json",
  "title": "Additive fields on POST /api/story response (feature 002) — merged into specs/001-vietleap-insight-kit/contracts/story.schema.json by T210",
  "type": "object",
  "properties": {
    "question": {
      "type": ["object", "null"],
      "description": "Decision question quoted from out/<ds>/brief.json; never rewritten by the LLM",
      "properties": {
        "text": {"type": "string", "maxLength": 2000},
        "who": {"type": ["string", "null"], "maxLength": 300},
        "what": {"type": ["string", "null"], "maxLength": 600},
        "kpi": {"type": ["string", "null"], "maxLength": 300},
        "source": {"const": "brief"}
      },
      "required": ["text", "source"],
      "additionalProperties": false
    },
    "limits": {
      "type": "array",
      "maxItems": 3,
      "items": {"type": "string"},
      "description": "Copied verbatim from results.json caveats"
    }
  }
}
