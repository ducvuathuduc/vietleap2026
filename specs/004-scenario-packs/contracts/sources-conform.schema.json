{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sources-conform.schema.json",
  "title": "sources.yaml additions (feature 004): per-column agg, ratio recompute, post_sql views",
  "$defs": {
    "aggFn": {"enum": ["mean", "sum", "min", "max", "first"]},
    "conform": {
      "type": "object",
      "properties": {
        "where": {"type": "string", "maxLength": 500},
        "agg": {
          "oneOf": [
            {"$ref": "#/$defs/aggFn"},
            {
              "type": "object",
              "properties": {
                "default": {"$ref": "#/$defs/aggFn"},
                "columns": {"type": "object", "additionalProperties": {"$ref": "#/$defs/aggFn"}}
              },
              "required": ["default"],
              "additionalProperties": false
            }
          ]
        },
        "ratios": {
          "type": "object",
          "description": "name → [numerator column, denominator column]; recomputed after aggregation as SUM(num)/NULLIF(SUM(den),0)",
          "additionalProperties": {"type": "array", "items": {"type": "string"}, "minItems": 2, "maxItems": 2}
        },
        "geo_level": {"enum": ["63", "2025", "34"]},
        "province": {"type": "string"},
        "prefix_columns": {"type": "boolean", "default": true},
        "province_rollup": {
          "type": "object",
          "required": ["sum"],
          "properties": {
            "sum": {"type": "array", "minItems": 1, "items": {"type": "string"}},
            "ratios": {"type": "object", "additionalProperties": {"type": "array", "items": {"type": "string"}, "minItems": 2, "maxItems": 2}}
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "type": "object",
  "properties": {
    "primary": {"type": "string"},
    "analysis_table": {"type": "string", "pattern": "^gold\\.[a-z0-9_]+$"},
    "post_sql": {
      "type": "array",
      "description": "CLI/YAML only (rejected by POST /api/ingest). One warehouse-only view definition per item.",
      "items": {"type": "string", "pattern": "^(?:[a-zA-Z0-9_-]+\\.sql$|\\s*CREATE\\s+OR\\s+REPLACE\\s+VIEW\\s+gold\\.v_[a-z0-9_]+\\s+AS\\s+(SELECT|WITH)\\b)"}
    }
  }
}
