{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "NPL dashboard snapshot",
  "type": "object",
  "required": [
    "meta",
    "headline",
    "kpis",
    "series",
    "quarter_effects",
    "banks",
    "heterogeneity",
    "linkage",
    "market",
    "forecast",
    "robustness",
    "method",
    "limitations",
    "legal",
    "ai_use"
  ],
  "properties": {
    "meta": {
      "type": "object",
      "required": [
        "snapshot_id",
        "generated_at",
        "period_start",
        "period_end",
        "n_banks",
        "n_bank_quarters",
        "publish_bank_series",
        "sources",
        "quality"
      ],
      "properties": {
        "snapshot_id": {
          "type": "string",
          "minLength": 1
        },
        "generated_at": {
          "type": "string",
          "format": "date-time"
        },
        "period_start": {
          "$ref": "#/$defs/period"
        },
        "period_end": {
          "$ref": "#/$defs/period"
        },
        "n_banks": {
          "type": "integer",
          "minimum": 0
        },
        "n_bank_quarters": {
          "type": "integer",
          "minimum": 0
        },
        "publish_bank_series": {
          "type": "boolean"
        },
        "sources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/source"
          }
        },
        "quality": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/quality"
          }
        }
      },
      "additionalProperties": false
    },
    "headline": {
      "type": "object",
      "required": [
        "vi",
        "en",
        "keys"
      ],
      "properties": {
        "vi": {
          "type": "string",
          "minLength": 1
        },
        "en": {
          "type": "string",
          "minLength": 1
        },
        "keys": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "kpis": {
      "type": "object",
      "required": [
        "level",
        "benchmark",
        "trend"
      ],
      "properties": {
        "level": {
          "type": "object",
          "required": [
            "npl_median_pct",
            "period",
            "n_banks"
          ],
          "properties": {
            "npl_median_pct": {
              "type": [
                "number",
                "null"
              ]
            },
            "period": {
              "$ref": "#/$defs/period"
            },
            "n_banks": {
              "type": "integer",
              "minimum": 0
            }
          },
          "additionalProperties": false
        },
        "benchmark": {
          "type": "object",
          "required": [
            "q4_coef_pp",
            "ci95",
            "p",
            "p_wild_bootstrap",
            "n",
            "clusters"
          ],
          "properties": {
            "q4_coef_pp": {
              "type": "number"
            },
            "ci95": {
              "$ref": "#/$defs/ci95"
            },
            "p": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0,
              "maximum": 1
            },
            "p_wild_bootstrap": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0,
              "maximum": 1
            },
            "n": {
              "type": "integer",
              "minimum": 0
            },
            "clusters": {
              "type": "integer",
              "minimum": 0
            }
          },
          "additionalProperties": false
        },
        "trend": {
          "type": "object",
          "required": [
            "down_then_up",
            "npl_4q_avg_median_pct",
            "period"
          ],
          "properties": {
            "down_then_up": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "year",
                  "share_pct",
                  "n"
                ],
                "properties": {
                  "year": {
                    "type": "integer",
                    "minimum": 1900
                  },
                  "share_pct": {
                    "type": "number"
                  },
                  "n": {
                    "type": "integer",
                    "minimum": 0
                  }
                },
                "additionalProperties": false
              }
            },
            "npl_4q_avg_median_pct": {
              "type": [
                "number",
                "null"
              ]
            },
            "period": {
              "$ref": "#/$defs/period"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "series": {
      "type": "object",
      "required": [
        "median_by_period"
      ],
      "properties": {
        "median_by_period": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/quarterSeries"
          },
          "minItems": 1
        }
      },
      "additionalProperties": false
    },
    "quarter_effects": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "quarter",
          "coef_pp",
          "ci95",
          "p",
          "p_wild_bootstrap"
        ],
        "properties": {
          "quarter": {
            "enum": [
              2,
              3,
              4
            ]
          },
          "coef_pp": {
            "type": "number"
          },
          "ci95": {
            "$ref": "#/$defs/ci95"
          },
          "p": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0,
            "maximum": 1
          },
          "p_wild_bootstrap": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0,
            "maximum": 1
          }
        },
        "additionalProperties": false
      },
      "minItems": 3,
      "maxItems": 3
    },
    "banks": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/bank"
      }
    },
    "heterogeneity": {
      "type": "object",
      "required": [
        "pre_period",
        "high_banks",
        "regression",
        "reading",
        "what_this_does_not_show"
      ],
      "properties": {
        "pre_period": {
          "type": "string",
          "minLength": 1
        },
        "high_banks": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "regression": {
          "$ref": "#/$defs/regression"
        },
        "reading_en": { "type": "string", "minLength": 1 },
        "what_this_does_not_show_en": { "type": "string", "minLength": 1 },
        "reading": {
          "type": "string",
          "minLength": 1
        },
        "what_this_does_not_show": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "linkage": {
      "type": "object",
      "required": [
        "seasonal",
        "correlation",
        "correlation_n",
        "roa_note",
        "reading",
        "what_this_does_not_show"
      ],
      "properties": {
        "seasonal": {
          "type": "object",
          "required": [
            "d_coverage_pct",
            "d_nim_pct",
            "loan_growth_yoy_pct"
          ],
          "properties": {
            "d_coverage_pct": {
              "$ref": "#/$defs/regression"
            },
            "d_nim_pct": {
              "$ref": "#/$defs/regression"
            },
            "loan_growth_yoy_pct": {
              "$ref": "#/$defs/regression"
            }
          },
          "additionalProperties": false
        },
        "correlation": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": {
              "type": [
                "number",
                "null"
              ]
            }
          }
        },
        "correlation_n": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "roa_note": {
          "type": "string",
          "minLength": 1
        },
        "reading_en": { "type": "string", "minLength": 1 },
        "what_this_does_not_show_en": { "type": "string", "minLength": 1 },
        "reading": {
          "type": "string",
          "minLength": 1
        },
        "what_this_does_not_show": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "market": {
      "type": "object",
      "required": [
        "car_by_day",
        "regressions"
      ],
      "properties": {
        "car_by_day": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/carDay"
          }
        },
        "regressions": {
          "type": "object",
          "oneOf": [
            {
              "required": ["raw", "adjusted", "raw_q4", "adjusted_q4"]
            },
            {
              "required": ["reported_or_deadline", "deadline_only", "reported_or_deadline_q4",
                           "deadline_only_q4", "actual_dates", "matched_actual", "matched_deadline"]
            }
          ],
          "properties": {
            "raw": {
              "$ref": "#/$defs/regression"
            },
            "adjusted": {
              "$ref": "#/$defs/regression"
            },
            "raw_q4": {
              "$ref": "#/$defs/regression"
            },
            "adjusted_q4": {
              "$ref": "#/$defs/regression"
            },
            "reported_or_deadline": {
              "$ref": "#/$defs/regression"
            },
            "deadline_only": {
              "$ref": "#/$defs/regression"
            },
            "reported_or_deadline_q4": {
              "$ref": "#/$defs/regression"
            },
            "deadline_only_q4": {
              "$ref": "#/$defs/regression"
            },
            "actual_dates": {
              "$ref": "#/$defs/regression"
            },
            "matched_actual": {
              "$ref": "#/$defs/regression"
            },
            "matched_deadline": {
              "$ref": "#/$defs/regression"
            }
          },
          "additionalProperties": false
        },
        "deadline_car_by_day": {
          "type": "array",
          "items": { "$ref": "#/$defs/carDay" }
        },
        "coverage": {
          "type": "object",
          "required": ["bank_quarters_n", "actual_date_n", "actual_date_pct", "actual_date_car_n",
                       "matched_clock_car_n", "deadline_fallback_n", "deadline_car_n", "period"],
          "properties": {
            "bank_quarters_n": { "type": "integer", "minimum": 0 },
            "actual_date_n": { "type": "integer", "minimum": 0 },
            "actual_date_pct": { "type": ["number", "null"], "minimum": 0, "maximum": 100 },
            "actual_date_car_n": { "type": "integer", "minimum": 0 },
            "matched_clock_car_n": { "type": "integer", "minimum": 0 },
            "deadline_fallback_n": { "type": "integer", "minimum": 0 },
            "deadline_car_n": { "type": "integer", "minimum": 0 },
            "period": { "$ref": "#/$defs/periodRange" }
          },
          "additionalProperties": false
        },
        "events_with_car": { "type": "integer", "minimum": 0 },
        "eligible_bank_quarters": { "type": "integer", "minimum": 0 },
        "period_start": { "anyOf": [{ "$ref": "#/$defs/period" }, { "type": "null" }] },
        "period_end": { "anyOf": [{ "$ref": "#/$defs/period" }, { "type": "null" }] },
        "reading_vi": { "type": "string", "minLength": 1 },
        "reading_en": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "forecast": {
      "type": "object",
      "required": [
        "backtest",
        "mae"
      ],
      "properties": {
        "backtest": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/backtestQuarter"
          }
        },
        "mae": {
          "type": "object",
          "required": [
            "model",
            "last_value",
            "seasonal_naive"
          ],
          "properties": {
            "model": {
              "type": [
                "number",
                "null"
              ]
            },
            "last_value": {
              "type": [
                "number",
                "null"
              ]
            },
            "seasonal_naive": {
              "type": [
                "number",
                "null"
              ]
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "robustness": {
      "type": "object",
      "required": [
        "leave_one_bank_out",
        "drop_2021_2022",
        "state_vs_private",
        "median_regression"
      ],
      "properties": {
        "leave_one_bank_out": {
          "type": "object",
          "required": [
            "min",
            "max"
          ],
          "properties": {
            "min": {
              "type": [
                "number",
                "null"
              ]
            },
            "max": {
              "type": [
                "number",
                "null"
              ]
            }
          },
          "additionalProperties": false
        },
        "drop_2021_2022": {
          "$ref": "#/$defs/regression"
        },
        "state_vs_private": {
          "type": "object",
          "required": [],
          "properties": {
            "state": {
              "$ref": "#/$defs/regression"
            },
            "private": {
              "$ref": "#/$defs/regression"
            }
          },
          "additionalProperties": false
        },
        "median_regression": {
          "$ref": "#/$defs/medianRegression"
        }
      },
      "additionalProperties": false
    },
    "method": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/method"
      },
      "minItems": 7,
      "maxItems": 7
    },
    "limitations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/text"
      }
    },
    "legal": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "ref",
          "text_vi",
          "text_en"
        ],
        "properties": {
          "ref": {
            "type": "string",
            "format": "uri"
          },
          "text_vi": {
            "type": "string",
            "minLength": 1
          },
          "text_en": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    },
    "ai_use": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/text"
      }
    },
    "findings": {
      "type": "array",
      "maxItems": 6,
      "items": { "$ref": "#/$defs/text" }
    },
    "reversal": {
      "type": "object",
      "required": ["n", "reversals", "share_pct", "period", "mean_next_q1_change_pp", "mean_next_q1_ci95"]
    },
    "decision_rule": {
      "type": "object",
      "required": ["latest_period", "latest", "q4_backtest", "band_level_pct", "reading_vi", "reading_en",
                   "does_not_show_vi", "does_not_show_en"],
      "properties": {
        "latest_period": { "$ref": "#/$defs/period" },
        "latest": {
          "type": "array",
          "items": {
            "allOf": [{ "$ref": "#/$defs/decision" }, { "required": ["bank_code"] }]
          }
        },
        "q4_backtest": {
          "type": "object",
          "required": ["unusual", "improving", "deteriorating", "within_normal_season"],
          "additionalProperties": {
            "type": "object",
            "required": ["n", "reversals", "share_pct", "ci95", "period"],
            "properties": {
              "n": { "type": "integer", "minimum": 0 },
              "reversals": { "type": "integer", "minimum": 0 },
              "share_pct": { "type": ["number", "null"], "minimum": 0, "maximum": 100 },
              "ci95": { "type": ["array", "null"], "items": { "type": "number" }, "minItems": 2, "maxItems": 2 },
              "period": { "$ref": "#/$defs/periodRange" }
            }
          }
        },
        "band_level_pct": { "const": 80 }
      }
    },
    "mechanism": {
      "type": "object",
      "required": ["coverage", "quarterly", "annual_writeoffs", "reading_vi", "reading_en",
                   "does_not_show_vi", "does_not_show_en"]
    },
    "context": {
      "type": "object",
      "required": ["wdi", "policy"]
    },
    "decoder": {
      "type": "object",
      "required": ["title_vi", "title_en", "periods", "banks", "rows", "fiinquant_rows", "regression", "reading_vi", "reading_en",
                   "does_not_show_vi", "does_not_show_en"],
      "properties": {
        "title_vi": { "type": "string", "minLength": 1 },
        "title_en": { "type": "string", "minLength": 1 },
        "periods": {
          "type": "array", "minItems": 6, "maxItems": 6, "uniqueItems": true,
          "items": { "$ref": "#/$defs/period" }
        },
        "banks": {
          "type": "array", "minItems": 8, "maxItems": 8, "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "rows": {
          "type": "array", "minItems": 48, "maxItems": 48,
          "items": { "$ref": "#/$defs/decoderRow" }
        },
        "fiinquant_rows": {
          "type": "array",
          "items": { "$ref": "#/$defs/decoderRow" }
        },
        "regression": {
          "type": "object",
          "required": ["outcome", "regressors", "estimator", "fiinquant", "notes"],
          "properties": {
            "outcome": { "const": "delta_npl_ratio" },
            "regressors": { "const": ["writeoff_ratio", "delta_g2_ratio", "loan_growth", "lagged_coverage"] },
            "fiinquant": { "$ref": "#/$defs/decoderFit" },
            "notes": { "$ref": "#/$defs/decoderFit" }
          }
        }
      }
    }
  },
  "additionalProperties": false,
  "if": {
    "properties": {
      "meta": {
        "properties": {
          "publish_bank_series": {
            "const": true
          }
        }
      }
    }
  },
  "then": {
    "properties": {
      "banks": {
        "items": {
          "required": [
            "series"
          ]
        }
      }
    }
  },
  "else": {
    "properties": {
      "banks": {
        "items": {
          "not": {
            "required": [
              "series"
            ]
          }
        }
      }
    }
  },
  "$defs": {
    "decoderRow": {
      "type": "object",
      "required": ["bank_code", "period", "status", "status_vi", "status_en", "signals", "missing_inputs",
                   "npl_ratio", "g2_ratio", "coverage", "writeoff_ratio", "npl_formation", "broad_problem_ratio"],
      "properties": {
        "bank_code": { "type": "string", "minLength": 1 },
        "period": { "$ref": "#/$defs/period" },
        "status": { "enum": ["CLEAN", "review", "missing_data", "not_applicable"] },
        "status_vi": { "type": "string", "minLength": 1 },
        "status_en": { "type": "string", "minLength": 1 },
        "signals": {
          "type": "array", "maxItems": 4,
          "items": {
            "type": "object", "required": ["id", "text_vi", "text_en"],
            "properties": {
              "id": { "enum": ["S1", "S2", "S3", "S4"] },
              "text_vi": { "type": "string", "minLength": 1 },
              "text_en": { "type": "string", "minLength": 1 }
            }
          }
        },
        "missing_inputs": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "npl_ratio": { "type": ["number", "null"] },
        "g2_ratio": { "type": ["number", "null"] },
        "coverage": { "type": ["number", "null"] },
        "writeoff_ratio": { "type": ["number", "null"] },
        "npl_formation": { "type": ["number", "null"] },
        "broad_problem_ratio": { "type": ["number", "null"] }
      },
      "if": { "properties": { "status": { "const": "CLEAN" } } },
      "then": { "properties": { "signals": { "maxItems": 0 }, "missing_inputs": { "maxItems": 0 } } }
    },
    "decoderFit": {
      "type": "object",
      "required": ["n_panel", "grid_n", "panel_period", "full", "available", "unavailable_fields", "n_by_field"],
      "properties": {
        "n_panel": { "type": "integer", "minimum": 0 },
        "grid_n": { "type": ["integer", "null"], "minimum": 0 },
        "panel_period": { "$ref": "#/$defs/periodRange" },
        "full": { "$ref": "#/$defs/regression" },
        "available": { "anyOf": [{ "$ref": "#/$defs/regression" }, { "type": "null" }] },
        "unavailable_fields": { "type": "array", "items": { "type": "string" } },
        "n_by_field": { "type": "object", "additionalProperties": { "type": "integer", "minimum": 0 } }
      }
    },
    "periodRange": {
      "type": ["array", "null"],
      "items": { "$ref": "#/$defs/period" },
      "minItems": 2,
      "maxItems": 2
    },
    "decision": {
      "type": "object",
      "required": ["period", "status", "status_vi", "status_en", "unusual", "d_npl_pct", "expected_change_pp",
                   "adjusted_change_pp", "lo80_pp", "hi80_pp", "train_n"],
      "properties": {
        "bank_code": { "type": "string", "minLength": 1 },
        "period": { "$ref": "#/$defs/period" },
        "status": { "enum": ["improving", "deteriorating", "within_normal_season", "unavailable"] },
        "status_vi": { "type": "string", "minLength": 1 },
        "status_en": { "type": "string", "minLength": 1 },
        "unusual": { "type": ["boolean", "null"] },
        "d_npl_pct": { "type": ["number", "null"] },
        "expected_change_pp": { "type": ["number", "null"] },
        "adjusted_change_pp": { "type": ["number", "null"] },
        "lo80_pp": { "type": ["number", "null"] },
        "hi80_pp": { "type": ["number", "null"] },
        "train_n": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "period": {
      "type": "string",
      "pattern": "^[1-9][0-9]{3}Q[1-4]$"
    },
    "ci95": {
      "anyOf": [
        {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 2,
          "maxItems": 2
        },
        {
          "type": "null"
        }
      ]
    },
    "text": {
      "type": "object",
      "required": [
        "vi",
        "en"
      ],
      "properties": {
        "vi": {
          "type": "string",
          "minLength": 1
        },
        "en": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "source": {
      "type": "object",
      "required": [
        "id",
        "name",
        "method",
        "url",
        "licence",
        "retrieved_at",
        "rows"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "method": {
          "enum": [
            "api",
            "scrape",
            "file"
