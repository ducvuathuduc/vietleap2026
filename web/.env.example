# Copy to web/.env.local (never commit real keys).
# FastAPI backend used by the /api/* rewrite and the AI analyst route
API_URL=http://127.0.0.1:8000
# Link shown in the sidebar
NEXT_PUBLIC_API_DOCS_URL=http://localhost:8000/docs

# AI Analyst — choose ONE; with neither set the analyst runs offline (top insights from the engine)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
# Any OpenAI-compatible endpoint (OpenRouter, Together, Ollama http://localhost:11434/v1, LM Studio ...)
OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_MODEL=
OPENAI_COMPATIBLE_API_KEY=
